# .pylintrc — Pylint configuration for AIVA_2026_Solder_Defect_Detector

[MAIN]

# Exclude legacy prototype and native C source directories from analysis.
ignore=_mockup,c_bindings

# Allow pylint to introspect compiled C extensions to resolve member names.
# Without this, every cv2.xxx call is flagged as E1101 (no-member).
extension-pkg-allow-list=cv2

[MESSAGES CONTROL]

# Rationale for each disabled rule:
#
#   E0401 (import-error)
#       cv2 / ultralytics are compiled C extensions installed at runtime;
#       pylint cannot resolve them in the static analysis environment.
#
#   E0402 (relative-beyond-top-level)
#       src.hardware and src.vision use project-root-relative imports that
#       pylint misreads when analysing files individually.
#
#   C0413 (wrong-import-position)
#       sys.path must be extended before src.* imports; the deferred import
#       is an intentional architectural requirement, not a style violation.
#
#   C0411 (wrong-import-order)
#       Suppressed because the import order is correct at runtime; pylint
#       misclassifies typing as a third-party import in some versions.
#
#   W0212 (protected-access)
#       Application, Detector, and the test suite intentionally access private
#       PCBImage attributes (_decoded_image, _image_data) within the same
#       package boundary for performance-critical inner loops.
#
#   R0903 (too-few-public-methods)
#       SolderDefect and Detector are data/single-responsibility classes;
#       adding artificial methods would reduce cohesion.
#
#   W0718 (broad-exception-caught)
#       Top-level entry points catch broad exceptions intentionally to prevent
#       unhandled crashes in the robot control process.
#
#   R0913, R0917 (too-many-arguments, too-many-positional-arguments)
#       SolderDefect.__init__ requires exactly 5 spatial + 1 confidence field;
#       reducing arguments would break the public API.
#
#   R0914 (too-many-locals)
#       The simulate loop accumulates several timing and statistical counters
#       that are all required for the final report.
#
#   R0912 (too-many-branches)
#       The argument-parsing and mode-dispatch block is a flat decision tree
#       by design; splitting further would add unnecessary indirection.
#
#   R0915 (too-many-statements)
#       The simulate loop is intentionally self-contained for readability.
#
disable=E0401,E0402,C0413,C0411,W0212,R0903,W0718,R0913,R0917,R0914,R0912,R0915,E1101,E0712

[FORMAT]

max-line-length=120

[SIMILARITIES]

min-similarity-lines=10
ignore-imports=yes
ignore-docstrings=yes

[REPORTS]

output-format=text
reports=yes
score=yes
