# ── OS & editor metadata ──────────────────────────────────────────────────────
.venv/
.vscode/
.env
**/.DS_Store

# ── Python bytecode ───────────────────────────────────────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo

# ── Test & analysis caches ────────────────────────────────────────────────────
.pytest_cache/
coverage.xml
.coverage

# ── Dataset directories (large; managed outside the repo) ─────────────────────
.data/
model_dev/datasets/
model_dev/dataset_yolo_grayscale/
model_dev/logs/
model_dev/__pycache__

# ── Generated output files ────────────────────────────────────────────────────
# XML inspection reports are generated at runtime; preserve folder via .gitkeep
reports/xml/*.xml

# Text simulation/stress reports are generated at runtime; keep example files
reports/simulate/*.txt
!reports/simulate/example.txt
reports/stress_tests/*.txt
!reports/stress_tests/example.txt

# ── Compiled C binding artefacts ──────────────────────────────────────────────
src/c_bindings/*.so
src/c_bindings/*.dylib
src/c_bindings/*.o